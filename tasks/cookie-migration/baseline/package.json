{
  "name": "multi-auth-lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace @multiauthlab/web",
    "start": "npm run start --workspace @multiauthlab/api",
    "doctor": "node scripts/doctor.js",
    "reset": "node apps/api/src/reset.js",
    "test": "node --test apps/api/tests/*.test.js"
  }
}
